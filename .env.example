# chave da OpenAI - pega em platform.openai.com/api-keys
OPENAI_API_KEY=

# modelo usado nas chamadas (gpt-4o-mini é rapido e barato, bom pra esse caso)
OPENAI_MODEL=gpt-4o-mini

# porta que o servidor vai subir localmente (o Render define sozinho em producao)
PORT=3333

# dominio do frontend, pra liberar no CORS (pode colocar varios separados por virgula)
CORS_ORIGIN=http://localhost:3000
